{
  "name": "dogfight",
  "private": true,
  "version": "0.0.0",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "description": "Arcade air combat game built with Three.js",
  "scripts": {
    "assets": "node tools/copy-atmosphere-assets.mjs && node tools/ac3d-to-glb.mjs",
    "dev": "vite",
    "predev": "npm run assets",
    "build": "tsc --noEmit && vite build",
    "prebuild": "npm run assets",
    "preview": "vite preview",
    "prepreview": "npm run assets",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "exact": "node tools/exact.mjs"
  },
  "dependencies": {
    "@takram/three-atmosphere": "^0.19.1",
    "@takram/three-geospatial": "^0.9.1",
    "postprocessing": "^6.39.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.4",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
