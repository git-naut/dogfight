{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "手動の掃引用。CI には載せない（3 ファイルで 13 分）。広げるときは docs/measuring.md の実測を見てから。--mutate で対象を上書きできる",
  "packageManager": "npm",
  "testRunner": "vitest",
  "mutate": [
    "src/sim/assist.ts",
    "src/sim/weapons/lock.ts",
    "src/sim/weapons/dlz.ts"
  ],
  "ignorePatterns": [
    "dist",
    "test-results",
    "playwright-report",
    "tests/e2e/smoke.spec.ts-snapshots"
  ],
  "coverageAnalysis": "perTest",
  "reporters": [
    "clear-text",
    "progress",
    "json"
  ],
  "timeoutMS": 60000,
  "concurrency": 4
}
